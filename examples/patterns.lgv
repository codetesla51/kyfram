let slide = table{
  "0": table{x: 60, y: 180, r: 50, color: "#e94560"},
  "1": table{x: 320, y: 180, r: 50, color: "#e94560"},
  "2": table{x: 580, y: 180, r: 50, color: "#e94560"}
}
let shrink = table{
  "0": table{x: 320, y: 180, r: 100, color: "#0f3460"},
  "1": table{x: 320, y: 180, r: 40, color: "#0f3460"},
  "2": table{x: 320, y: 180, r: 100, color: "#0f3460"}
}

scene(3, 30)
shape("circle1", "circle", mergeKeyframes(slide, table{color: "#ff7675"}))
shape("circle2", "circle", mergeKeyframes(slide, table{y: 260, color: "#55efc4"}))
shape("circle3", "circle", mergeKeyframes(slide, table{y: 100, color: "#74b9ff"}))
shape("pulse", "circle", mergeKeyframes(shrink, table{x: 320, y: 180, r: 80, color: "#a29bfe"}))