// ======================================================================
// BEAT 6 — bookend (20.375 .. 26.3)     "Kyfram. Video you declare, not direct."
// ======================================================================
scene(5.925, 30, "fade", 0.5)
shape("bg6", "rect", table{
  "0": table{x: 0, y: 0, w: 1920, h: 1080, color: bg},
  "4.9": table{x: 0, y: 0, w: 1920, h: 1080, color: bg, ease: "easeIn"},
  "5.925": table{x: 0, y: 0, w: 1920, h: 1080, color: "#000000"},
})
for i, w in v.words {
  if i >= 25 {
    if i <= 30 {
      let t0 = w.start - s6_start
      let t1 = w.end - s6_start
      if i == 25 { capword(i, w.word, 960, 400, 150, ink, 0, t1, 1) }       // Kyfram.
      if i == 26 { capword(i, w.word, 654.1, 640, 46, ink, t0, t1, 1) }    // Video
      if i == 27 { capword(i, w.word, 785.7, 640, 46, ink, t0, t1, 1) }    // you
      if i == 28 { capword(i, w.word, 945.7, 640, 46, gold, t0, t1, 1) }   // declare
      if i == 29 { capword(i, w.word, 1105.8, 640, 46, ink, t0, t1, 1) }   // not
      if i == 30 { capword(i, w.word, 1251.6, 640, 46, ink, t0, t1, 1) }   // direct
    }
  }
}
