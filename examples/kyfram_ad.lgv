let ink = "#ffffff"
let mint = "#7fd1a9"
let coral = "#e64c40"
let slate = "#6a6a78"
let bg = "#000000"
let fnt = "examples/assets/fonts/Geist-Bold.ttf"
let fntr = "examples/assets/fonts/Geist-Regular.ttf"

// ---- scene 1: wordmark ----
scene(1.75, 30)
shape("bg1", "rect", table{"0": table{x: 0, y: 0, w: 1080, h: 1350, color: bg}})
text("word1", table{
  "0.562": table{content: "kyfram", x: 540, y: 675, size: 72, color: ink, font: fnt, alpha: 0, scale: 0.9, ease: "cubicOut"},
  "0.812": table{content: "kyfram", x: 540, y: 675, size: 72, color: ink, font: fnt, alpha: 1, scale: 1.0}
})

// ---- scene 2: you declare states, kyfram fills the rest ----
scene(2.375, 30, "fade", 0.375)
shape("bg2", "rect", table{"0": table{x: 0, y: 0, w: 1080, h: 1350, color: bg}})
text("h2", table{
  "0.062": table{content: "you declare states", x: 540, y: 300, size: 40, color: ink, font: fnt, alpha: 0, ease: "cubicOut"},
  "0.312": table{content: "you declare states", x: 540, y: 300, size: 40, color: ink, font: fnt, alpha: 1}
})
shape("markA", "roundRect", table{
  "0": table{x: 280, y: 570, w: 40, h: 40, radius: 6, color: slate, alpha: 0, scale: 0.6, ease: "cubicOut"},
  "0.188": table{x: 280, y: 570, w: 40, h: 40, radius: 6, color: slate, alpha: 1, scale: 1.0},
  "2.375": table{x: 280, y: 570, w: 40, h: 40, radius: 6, color: slate, alpha: 1, scale: 1.0}
})
shape("markB", "roundRect", table{
  "0.25": table{x: 520, y: 420, w: 40, h: 40, radius: 6, color: slate, alpha: 0, scale: 0.6, ease: "cubicOut"},
  "0.438": table{x: 520, y: 420, w: 40, h: 40, radius: 6, color: slate, alpha: 1, scale: 1.0},
  "2.375": table{x: 520, y: 420, w: 40, h: 40, radius: 6, color: slate, alpha: 1, scale: 1.0}
})
shape("markC", "roundRect", table{
  "0.5": table{x: 760, y: 570, w: 40, h: 40, radius: 6, color: slate, alpha: 0, scale: 0.6, ease: "cubicOut"},
  "0.688": table{x: 760, y: 570, w: 40, h: 40, radius: 6, color: slate, alpha: 1, scale: 1.0},
  "2.375": table{x: 760, y: 570, w: 40, h: 40, radius: 6, color: slate, alpha: 1, scale: 1.0}
})
shape("filler", "circle", table{
  "0.938": table{x: 300, y: 590, r: 24, color: mint, alpha: 0, ease: "cubicInOut"},
  "1.062": table{x: 300, y: 590, r: 24, color: mint, alpha: 1},
  "1.625": table{x: 540, y: 440, r: 24, color: mint, alpha: 1, ease: "cubicInOut"},
  "2.188": table{x: 780, y: 590, r: 24, color: mint, alpha: 1},
  "2.375": table{x: 780, y: 590, r: 24, color: mint, alpha: 1}
})
text("h2b", table{
  "1.25": table{content: "kyfram fills the rest", x: 540, y: 850, size: 32, color: slate, font: fntr, alpha: 0, ease: "cubicOut"},
  "1.562": table{content: "kyfram fills the rest", x: 540, y: 850, size: 32, color: slate, font: fntr, alpha: 0.85}
})

// ---- scene 3: the keyframe table, made visible ----
scene(2.75, 30, "fade", 0.375)
shape("bg3", "rect", table{"0": table{x: 0, y: 0, w: 1080, h: 1350, color: bg}})
text("h3", table{
  "0.062": table{content: "a table of times and values", x: 540, y: 260, size: 32, color: ink, font: fnt, alpha: 0, ease: "cubicOut"},
  "0.312": table{content: "a table of times and values", x: 540, y: 260, size: 32, color: ink, font: fnt, alpha: 1}
})
shape("panel3", "roundRect", table{"0": table{x: 160, y: 420, w: 380, h: 280, radius: 16, color: "#101015"}})
shape("row0", "rect", table{
  "0.438": table{x: 190, y: 460, w: 320, h: 60, color: "#1c1c24", alpha: 0.3},
  "0.562": table{x: 190, y: 460, w: 320, h: 60, color: mint, alpha: 0.35, ease: "cubicOut"},
  "0.812": table{x: 190, y: 460, w: 320, h: 60, color: "#1c1c24", alpha: 0.3}
})
shape("row1", "rect", table{
  "1.125": table{x: 190, y: 540, w: 320, h: 60, color: "#1c1c24", alpha: 0.3},
  "1.25": table{x: 190, y: 540, w: 320, h: 60, color: mint, alpha: 0.35, ease: "cubicOut"},
  "1.5": table{x: 190, y: 540, w: 320, h: 60, color: "#1c1c24", alpha: 0.3}
})
shape("row2", "rect", table{
  "1.812": table{x: 190, y: 620, w: 320, h: 60, color: "#1c1c24", alpha: 0.3},
  "1.938": table{x: 190, y: 620, w: 320, h: 60, color: mint, alpha: 0.35, ease: "cubicOut"},
  "2.188": table{x: 190, y: 620, w: 320, h: 60, color: "#1c1c24", alpha: 0.3}
})
text("t0", table{"0.375": table{content: "0.00  →  x: 240", x: 350, y: 490, size: 22, color: ink, font: fntr, alpha: 0.9}, "2.75": table{content: "0.00  →  x: 240", x: 350, y: 490, size: 22, color: ink, font: fntr, alpha: 0.9}})
text("t1", table{"0.375": table{content: "0.45  →  x: 540", x: 350, y: 570, size: 22, color: ink, font: fntr, alpha: 0.9}, "2.75": table{content: "0.45  →  x: 540", x: 350, y: 570, size: 22, color: ink, font: fntr, alpha: 0.9}})
text("t2", table{"0.375": table{content: "1.00  →  x: 840", x: 350, y: 650, size: 22, color: ink, font: fntr, alpha: 0.9}, "2.75": table{content: "1.00  →  x: 840", x: 350, y: 650, size: 22, color: ink, font: fntr, alpha: 0.9}})
shape("liveball", "circle", table{
  "0.438": table{x: 740, y: 490, r: 22, color: coral, alpha: 0, ease: "cubicOut"},
  "0.562": table{x: 740, y: 490, r: 22, color: coral, alpha: 1},
  "1.25": table{x: 740, y: 570, r: 22, color: coral, alpha: 1, ease: "cubicInOut"},
  "1.938": table{x: 740, y: 650, r: 22, color: coral, alpha: 1},
  "2.75": table{x: 740, y: 650, r: 22, color: coral, alpha: 1}
})

// ---- scene 4: groups move as one, children stay local ----
scene(2.375, 30, "fade", 0.375)
shape("bg4", "rect", table{"0": table{x: 0, y: 0, w: 1080, h: 1350, color: bg}})
text("h4", table{
  "0.062": table{content: "groups move as one", x: 540, y: 300, size: 36, color: ink, font: fnt, alpha: 0, ease: "cubicOut"},
  "0.312": table{content: "groups move as one", x: 540, y: 300, size: 36, color: ink, font: fnt, alpha: 1}
})
group("trio", table{
  "0.438": table{x: 300, y: 650, rotate: 0, ease: "cubicInOut"},
  "1.25": table{x: 540, y: 650, rotate: 12},
  "2.062": table{x: 780, y: 650, rotate: 0}
})
shape("dot0", "circle", table{"0": table{x: -80, y: 0, r: 26, color: coral}}, "trio")
shape("dot1", "circle", table{"0": table{x: 0, y: 0, r: 26, color: mint}}, "trio")
shape("dot2", "circle", table{"0": table{x: 80, y: 0, r: 26, color: ink}}, "trio")
text("h4b", table{
  "1.125": table{content: "local coordinates never move", x: 540, y: 850, size: 28, color: slate, font: fntr, alpha: 0, ease: "cubicOut"},
  "1.438": table{content: "local coordinates never move", x: 540, y: 850, size: 28, color: slate, font: fntr, alpha: 0.85}
})

// ---- scene 5: stamp() reuses one animation ----
scene(2.125, 30, "fade", 0.375)
shape("bg5", "rect", table{"0": table{x: 0, y: 0, w: 1080, h: 1350, color: bg}})
text("h5", table{
  "0.062": table{content: "one animation, stamped x3", x: 540, y: 280, size: 32, color: ink, font: fnt, alpha: 0, ease: "cubicOut"},
  "0.312": table{content: "one animation, stamped x3", x: 540, y: 280, size: 32, color: ink, font: fnt, alpha: 1}
})
let hop5 = table{
  "0.438": table{y: 0, r: 30, alpha: 0, scale: 0.4, ease: "cubicOut"},
  "0.688": table{y: 0, r: 30, alpha: 1, scale: 1.0},
  "1.062": table{y: -90, scale: 0.9, ease: "cubicOut"},
  "1.375": table{y: 0, scale: 1.0, ease: "cubicInOut"},
  "2.125": table{y: 0, scale: 1.0}
}
group("hopRow", table{"0": table{x: 540, y: 700}})
shape("hopA", "circle", stamp(hop5, table{x: -220, color: coral}), "hopRow")
shape("hopB", "circle", stamp(hop5, table{x: 0, color: mint}), "hopRow")
shape("hopC", "circle", stamp(hop5, table{x: 220, color: ink}), "hopRow")

// ---- scene 6: closer ----
scene(1.75, 30, "fade", 0.5)
shape("bg6", "rect", table{"0": table{x: 0, y: 0, w: 1080, h: 1350, color: bg}})
text("word6", table{
  "0.375": table{content: "kyfram.", x: 540, y: 650, size: 56, color: ink, font: fnt, alpha: 0, scale: 0.9, ease: "cubicOut"},
  "0.625": table{content: "kyfram.", x: 540, y: 650, size: 56, color: ink, font: fnt, alpha: 1, scale: 1.0}
})
text("tag6", table{
  "0.688": table{content: "video you declare, not direct", x: 540, y: 715, size: 22, color: slate, font: fntr, alpha: 0, ease: "sine"},
  "1": table{content: "video you declare, not direct", x: 540, y: 715, size: 22, color: slate, font: fntr, alpha: 0.85},
  "1.75": table{content: "video you declare, not direct", x: 540, y: 715, size: 22, color: slate, font: fntr, alpha: 0.85}
})
