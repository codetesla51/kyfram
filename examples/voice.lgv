let v = tts("hey my name is uthman welcome to kyfram", "/tmp/voice.wav")

scene(v.duration + 0.5, 30)

audio(v.audio)
audio("/home/uthman/Music/1-01. Stereo Madness.mp3")

shape("bg", "rect", table{
  "0": table{x: 0, y: 0, w: 640, h: 360, color: "#0a0a18"},
  str(v.duration + 0.5): table{x: 0, y: 0, w: 640, h: 360, color: "#0a0a18"}
})

for i, w in v.words {
  text("w" + str(i), table{
    str(w.start): table{content: w.word, x: 320, y: 180, size: 56, color: "white", alpha: 0},
    str(w.start + 0.08): table{content: w.word, x: 320, y: 180, size: 56, color: "white", alpha: 1},
    str(w.end): table{content: w.word, x: 320, y: 180, size: 56, color: "white", alpha: 1},
    str(w.end + 0.15): table{content: w.word, x: 320, y: 180, size: 56, color: "white", alpha: 0}
  })
}
