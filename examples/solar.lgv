scene(6, 30)

shape("sun", "circle", table{
    "0": table{x: 320, y: 180, r: 30, color: "#e6a23c"},
})

// mercury
let mercury = table{}
for i in range(0, 120) {
    let t = 0.05 * i
    let a = 3.0 * t
    mercury[toStr(t)] = table{x: 320 + 55*cos(a), y: 180 + 14*sin(a), r: 4, color: "#8a8a80"}
}
shape("mercury", "circle", mercury)

// venus
let venus = table{}
for i in range(0, 120) {
    let t = 0.05 * i
    let a = 2.2 * t
    venus[toStr(t)] = table{x: 320 + 80*cos(a), y: 180 + 20*sin(a), r: 6, color: "#e0a96d"}
}
shape("venus", "circle", venus)

// earth
let earth = table{}
for i in range(0, 120) {
    let t = 0.05 * i
    let a = 1.7 * t
    earth[toStr(t)] = table{x: 320 + 110*cos(a), y: 180 + 28*sin(a), r: 7, color: "#4c8be6"}
}
shape("earth", "circle", earth)

// mars
let mars = table{}
for i in range(0, 120) {
    let t = 0.05 * i
    let a = 1.3 * t
    mars[toStr(t)] = table{x: 320 + 140*cos(a), y: 180 + 36*sin(a), r: 5, color: "#c1440e"}
}
shape("mars", "circle", mars)

// jupiter
let jupiter = table{}
for i in range(0, 120) {
    let t = 0.05 * i
    let a = 0.8 * t
    jupiter[toStr(t)] = table{x: 320 + 190*cos(a), y: 180 + 48*sin(a), r: 14, color: "#c9a06a"}
}
shape("jupiter", "circle", jupiter)

// earth's orbit ring — hand-computed ellipse points, matches earth's rx/ry exactly
let ring_pts = []
for i in range(0, 48) {
    let ang = (2.0 * pi() / 48) * i
    push(ring_pts, 320 + 110*cos(ang))
    push(ring_pts, 180 + 28*sin(ang))
}
shape("ring_earth", "path", table{
    "0": table{points: ring_pts, closed: true, filled: false, width: 1, color: "#343531"},
})
