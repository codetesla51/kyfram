  "2.311": table{x: 998, y: 356, content: "?", size: 150, font: display, color: mustard, scale: 1.0, alpha: 1}
})

shape("underline", "rect", table{
  "0": table{x: 400, y: 486, w: 0, h: 7, color: orange, alpha: 1},
  "0.722": table{x: 400, y: 486, w: 500, h: 7, color: orange, alpha: 1, ease: "cubicOut"},
  "2.311": table{x: 400, y: 486, w: 500, h: 7, color: orange, alpha: 1}
})

text("hook-sub", table{
  "0": table{x: 650, y: 558, content: "SMASH BURGERS / NO NONSENSE", size: 19, font: body, color: cream, alpha: 0, ease: "cubicOut"},
  "1.083": table{x: 650, y: 548, content: "SMASH BURGERS / NO NONSENSE", size: 19, font: body, color: cream, alpha: 0.68},
  "2.311": table{x: 650, y: 548, content: "SMASH BURGERS / NO NONSENSE", size: 19, font: body, color: cream, alpha: 0.68}
})

group("stamp", table{
  "0": table{x: 1102, y: 178, scale: 0.33, rotate: 14, alpha: 0, ease: "cubicOut"},
  "0.462": table{x: 1102, y: 170, scale: 0.56, rotate: 0, alpha: 1, ease: "sine"},
  "1.733": table{x: 1100, y: 164, scale: 0.577, rotate: -4, alpha: 1, ease: "sine"},
  "2.311": table{x: 1096, y: 158, scale: 0.585, rotate: -8, alpha: 1}
})
shape("stamp-out", "circle", still(1.6, table{x: 0, y: 0, r: 120, color: orange}), "stamp")
shape("stamp-in", "circle", still(1.6, table{x: 0, y: 0, r: 108, color: burgundy}), "stamp")
addBurger("stamp", burgundy, 1.6)

// ---------------------------------------------------------------
