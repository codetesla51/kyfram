// SCENE 1 — the hook
// ---------------------------------------------------------------
scene(2.311, 30)
camera(table{
  "0": table{x: 640, y: 360, zoom: 1.0, ease: "sine"},
  "2.311": table{x: 650, y: 352, zoom: 1.045}
})

shape("bg", "rect", still(1.6, table{x: 0, y: 0, w: 1280, h: 720, color: cocoa}))
shape("stripe", "rect", table{
  "0": table{x: -100, y: 92, w: 1500, h: 96, color: orange, alpha: 0.13, rotate: -6, ease: "sine"},
  "2.311": table{x: -150, y: 88, w: 1500, h: 96, color: orange, alpha: 0.13, rotate: -8.5}
})
shape("sun", "circle", table{
  "0": table{x: 1130, y: 610, r: 360, color: "#32160E", ease: "sine"},
  "2.311": table{x: 1094, y: 584, r: 376, color: "#32160E"}
})

text("hungry", table{
  "0": table{x: 588, y: 366, content: "HUNGRY", size: 150, font: display, color: cream, scale: 1.10, alpha: 0, ease: "cubicOut"},
  "0.26": table{x: 588, y: 356, content: "HUNGRY", size: 150, font: display, color: cream, scale: 1.0, alpha: 1},
  "2.311": table{x: 588, y: 356, content: "HUNGRY", size: 150, font: display, color: cream, scale: 1.0, alpha: 1}
})

text("question", table{
