shape("cup-lid", "roundRect", still(2.6, table{x: -29, y: -46, w: 58, h: 11, radius: 4, color: burgundy}), "cup")

group("fries", still(2.6, table{x: 855, y: 512, scale: 1, alpha: 1, layer: 3}))
