// burger-ad.lgv — 9s burger spot: hook, people, hero stack, logo.
// Everything is vector; fonts are the repo's bundled faces.

let tq = fn(t) { return format("%.3f", t) }
let still = fn(dur, p) {
  let k = table{}
  k["0"] = p
  k[tq(dur)] = p
  return k
}

let cocoa = "#1D0F0A"
let cream = "#F7E8CC"
let orange = "#F26B2A"
let mustard = "#F4B942"
let burgundy = "#6B1F1F"
let wood = "#8C4A2F"
let woodDark = "#63331F"
let green = "#5E8C45"
let greenLight = "#6FA052"
let ink = "#24160F"

let display = "examples/assets/fonts/ArchivoBlack-Regular.ttf"
let body = "examples/assets/fonts/Geist-Bold.ttf"
let bodyRegular = "examples/assets/fonts/Geist-Regular.ttf"

// Music bed + neural voiceover, mixed to the 13s picture.
audio("examples/assets/burger-ad-audio.mp3")

// Shared burger mark. The bite is cut out with a dot in the
// background color, so the same glyph works on cream or burgundy.
let addBurger = fn(g, biteColor, dur) {
  shape(g + "-top", "path", still(dur, table{
    points: [-62, -12, -58, -34, -42, -49, -20, -57, 0, -59, 20, -57, 42, -49, 58, -34, 62, -12],
    filled: true, color: orange
  }), g)
  shape(g + "-seed1", "ellipse", still(dur, table{x: -31, y: -36, rx: 5, ry: 2.5, color: cream, rotate: 18}), g)
  shape(g + "-seed2", "ellipse", still(dur, table{x: -8, y: -47, rx: 5, ry: 2.5, color: cream, rotate: -6}), g)
  shape(g + "-seed3", "ellipse", still(dur, table{x: 17, y: -45, rx: 5, ry: 2.5, color: cream, rotate: 12}), g)
  shape(g + "-seed4", "ellipse", still(dur, table{x: 39, y: -33, rx: 5, ry: 2.5, color: cream, rotate: -18}), g)
  shape(g + "-cheese", "path", still(dur, table{
    points: [-66, -12, 66, -12, 66, -2, 52, -2, 42, 12, 29, -2, 10, -2, 0, 10, -10, -2, -38, -2, -48, 10, -58, -2, -66, -2],
    filled: true, color: mustard
  }), g)
  shape(g + "-lettuce", "ellipse", still(dur, table{x: 0, y: 5, rx: 64, ry: 7, color: green}), g)
  shape(g + "-lettuce2", "ellipse", still(dur, table{x: 0, y: 7, rx: 58, ry: 5, color: greenLight}), g)
  shape(g + "-patty", "roundRect", still(dur, table{x: -56, y: 10, w: 112, h: 16, radius: 8, color: "#3A1A10"}), g)
  shape(g + "-bottom", "ellipse", still(dur, table{x: 0, y: 31, rx: 64, ry: 13, color: orange}), g)
  shape(g + "-bottom-light", "ellipse", still(dur, table{x: 0, y: 27, rx: 51, ry: 6, color: "#F6C987", alpha: 0.7}), g)
  shape(g + "-bite", "circle", still(dur, table{x: 54, y: -17, r: 15, color: biteColor}), g)
}

