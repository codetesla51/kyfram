scene(3.756, 30, "fade", 0.433)

shape("bg", "rect", still(2.6, table{x: 0, y: 0, w: 1280, h: 720, color: cream}))
shape("bg-sun", "circle", still(2.6, table{x: 1180, y: 86, r: 225, color: orange, alpha: 0.10}))
