})

// One reusable person. Local coordinates keep the group easy to bob.
let addPerson = fn(name, px, shirt, skin, hair, lean, phase, lift) {
  let bob = table{}
  for i in range(0, 27) {
    let t = i * 0.1444
    let a = 6.28318 * t / 1.4444 + phase
    bob[tq(t)] = table{x: px, y: 434 + 2.2 * sin(a), rotate: lean * sin(a), layer: 1}
  }
  group(name, bob)

  let handX = 62
  let handY = 28 - 100 * lift

  shape(name + "-torso", "roundRect", still(2.6, table{x: -58, y: -20, w: 116, h: 200, radius: 48, color: shirt}), name)
  shape(name + "-neck", "roundRect", still(2.6, table{x: -18, y: -58, w: 36, h: 52, radius: 16, color: skin}), name)
  shape(name + "-arm-l", "path", still(2.6, table{points: [-40, -10, -76, 24, -64, 52], width: 15, cap: "round", join: "round", color: shirt}), name)
  shape(name + "-arm-r", "path", still(2.6, table{points: [40, -10, 76, 10 - 30 * lift, handX, handY], width: 15, cap: "round", join: "round", color: shirt}), name)
  shape(name + "-hand-l", "circle", still(2.6, table{x: -64, y: 52, r: 10, color: skin}), name)
  shape(name + "-hand-r", "circle", still(2.6, table{x: handX, y: handY, r: 10, color: skin}), name)
  shape(name + "-hair", "ellipse", still(2.6, table{x: 0, y: -117, rx: 51, ry: 49, color: hair}), name)
  shape(name + "-head", "circle", still(2.6, table{x: 0, y: -105, r: 44, color: skin}), name)
  shape(name + "-eye-l", "circle", still(2.6, table{x: -15, y: -110, r: 3.6, color: ink}), name)
  shape(name + "-eye-r", "circle", still(2.6, table{x: 15, y: -110, r: 3.6, color: ink}), name)
  shape(name + "-brow-l", "line", still(2.6, table{x1: -24, y1: -122, x2: -7, y2: -124, width: 3, color: hair}), name)
  shape(name + "-brow-r", "line", still(2.6, table{x1: 7, y1: -124, x2: 24, y2: -122, width: 3, color: hair}), name)
  shape(name + "-smile", "path", still(2.6, table{points: [-13, -88, 0, -80, 13, -88], width: 3, cap: "round", join: "round", color: "#7A3C23"}), name)
}

addPerson("p1", 350, mustard, "#C97B4A", "#2A1710", -1.4, 0.0, 0)
addPerson("p2", 640, orange, "#8C4F2C", "#1B100B", 0.8, 2.1, 1)
addPerson("p3", 930, green, "#E0A075", "#6B3B1F", 1.3, 4.2, 0)

// Extra character details, drawn after the base body.
