use "helpers/spike"

scene(10, 30)

audio("/home/uthman/Music/1-01. Stereo Madness.mp3")

shape("bg", "rect", table{
  "0": table{x: 0, y: 0, w: 640, h: 360, color: "#0a0a18"},
  "5.50": table{x: 0, y: 0, w: 640, h: 360, color: "#0a0a18"},
  "6.50": table{x: 0, y: 0, w: 640, h: 360, color: "#1a0a1a"},
  "8.50": table{x: 0, y: 0, w: 640, h: 360, color: "#0a0a18"},
  "10": table{x: 0, y: 0, w: 640, h: 360, color: "#0a0a18"}
})

shape("ground", "line", table{
  "0": table{x1: 0, y1: 310, x2: 640, y2: 310, width: 3, color: "cyan"},
  "5.50": table{x1: 0, y1: 310, x2: 640, y2: 310, width: 3, color: "cyan"},
  "6.50": table{x1: 0, y1: 310, x2: 640, y2: 310, width: 4, color: "gold"},
  "8.50": table{x1: 0, y1: 310, x2: 640, y2: 310, width: 3, color: "cyan"},
  "10": table{x1: 0, y1: 310, x2: 640, y2: 310, width: 3, color: "cyan"}
})

shape("wave1", "wave", table{
  "0": table{x: 0, y: 80, width: 640, amplitude: 12, frequency: 3, phase: 0, thickness: 2, color: "slate"},
  "5.50": table{x: 0, y: 80, width: 640, amplitude: 12, frequency: 3, phase: 330, thickness: 2, color: "slate"},
  "6.50": table{x: 0, y: 80, width: 640, amplitude: 26, frequency: 6, phase: 420, thickness: 3, color: "slate"},
  "8.50": table{x: 0, y: 80, width: 640, amplitude: 12, frequency: 3, phase: 600, thickness: 2, color: "slate"},
  "10": table{x: 0, y: 80, width: 640, amplitude: 12, frequency: 3, phase: 720, thickness: 2, color: "slate"}
})

camera(table{
  "0": table{x: 320, y: 180, zoom: 1},
  "2": table{x: 315, y: 175, zoom: 1.06, ease: "sine"},
  "4": table{x: 325, y: 185, zoom: 1, ease: "sine"},
  "5.50": table{x: 320, y: 180, zoom: 1, ease: "sine"},
  "6.50": table{x: 318, y: 200, zoom: 1.22, ease: "sine"},
  "7.50": table{x: 322, y: 190, zoom: 1.08, ease: "sine"},
  "8.50": table{x: 320, y: 180, zoom: 1, ease: "sine"},
  "10": table{x: 320, y: 180, zoom: 1}
})

shape("cube", "rect", table{
  "0": table{x: 120, y: 270, w: 40, h: 40, color: "mint"},
  "1.20": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 90, ease: "easeOut"},
  "1.55": table{x: 120, y: 170, w: 40, h: 40, color: "gold", rotate: 180, ease: "easeIn"},
  "1.90": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 270},
  "2.70": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 270, ease: "easeOut"},
  "3.05": table{x: 120, y: 170, w: 40, h: 40, color: "gold", rotate: 360, ease: "easeIn"},
  "3.40": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 450},
  "4.10": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 450, ease: "easeOut"},
  "4.45": table{x: 120, y: 170, w: 40, h: 40, color: "gold", rotate: 540, ease: "easeIn"},
  "4.80": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 630},
  "5.50": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 630},
  "5.85": table{x: 120, y: 170, w: 40, h: 40, color: "gold", rotate: 720, ease: "easeIn"},
  "6.20": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 810},
  "6.35": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 810, ease: "easeOut"},
  "6.60": table{x: 120, y: 170, w: 40, h: 40, color: "gold", rotate: 900, ease: "easeIn"},
  "6.85": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 990},
  "7.00": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 990, ease: "easeOut"},
  "7.25": table{x: 120, y: 170, w: 40, h: 40, color: "gold", rotate: 1080, ease: "easeIn"},
  "7.50": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 1170},
  "7.65": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 1170, ease: "easeOut"},
  "7.90": table{x: 120, y: 170, w: 40, h: 40, color: "gold", rotate: 1260, ease: "easeIn"},
  "8.15": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 1350},
  "8.80": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 1350},
  "10": table{x: 120, y: 270, w: 40, h: 40, color: "mint", rotate: 1350}
})

spikeAt("spike1", 1.55, "coral")
spikeAt("spike2", 3.05, "coral")
spikeAt("spike3", 4.45, "coral")
spikeAt("spike4", 5.85, "coral")
spikeAt("spike5", 6.60, "red")
spikeAt("spike6", 7.25, "red")
spikeAt("spike7", 7.90, "red")
