  gradFrom: "#0B0B13", gradTo: "#060609", gradAngle: 90,
}))
shape("s2-halo", "circle", still(4.2, table{
  x: 1480, y: 520, r: 420, color: cyan, alpha: 0.025,
}))

text("s2-kicker", table{
  "0": table{content: "01  /  DECLARE", x: 960, y: 188, size: 19, color: cyan, font: display, alpha: 0},
  "0.45": table{content: "01  /  DECLARE", x: 960, y: 188, size: 19, color: cyan, font: display, alpha: 1, ease: "easeOut"},
  "4.2": table{content: "01  /  DECLARE", x: 960, y: 188, size: 19, color: cyan, font: display, alpha: 1},
})

letters("s2-title", "states at times", table{
  "0.1": table{x: 960, y: 276, size: 86, color: white, font: display, alpha: 0, scale: 0.96},
  "0.7": table{x: 960, y: 276, size: 86, color: white, font: display, alpha: 1, scale: 1, ease: "spring"},
  "4.2": table{x: 960, y: 276, size: 86, color: white, font: display, alpha: 1, scale: 1},
}, 0.032)

text("s2-sub", table{
  "0.55": table{content: "No callbacks. No timeline editor. Just keyframes.", x: 960, y: 354, size: 25, color: muted, font: body, alpha: 0},
  "1.05": table{content: "No callbacks. No timeline editor. Just keyframes.", x: 960, y: 350, size: 25, color: muted, font: body, alpha: 1, ease: "easeOut"},
