// kyfram-promo.lgv — a 25.6s launch film for kyfram.
// Everything here is rendered by kyfram itself: SVG import, keyframes,
// letters, stroke trim, nested groups, clipping, effects, and camera.
audio("examples/assets/kyfram-promo.mp3")

let still = fn(dur, p) {
  let k = table{}
  k["0"] = p
  k[str(dur)] = p
  return k
}

let bg = "#07070B"
let panel = "#0E0E16"
let panel2 = "#12121C"
let white = "#F6F1E7"
let muted = "#8F8F86"
let cyan = "#5FD0C4"
let gold = "#F4B942"
let coral = "#FF6B4A"
let display = "examples/assets/fonts/Geist-Bold.ttf"
let body = "examples/assets/fonts/Geist-Regular.ttf"

// A faint grid runs under every scene, so cuts and camera moves feel
// like they happen inside one continuous space.
shape("grid-v1", "line", still(25.6, table{x1: 240, y1: 0, x2: 240, y2: 1080, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-v2", "line", still(25.6, table{x1: 480, y1: 0, x2: 480, y2: 1080, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-v3", "line", still(25.6, table{x1: 720, y1: 0, x2: 720, y2: 1080, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-v4", "line", still(25.6, table{x1: 960, y1: 0, x2: 960, y2: 1080, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-v5", "line", still(25.6, table{x1: 1200, y1: 0, x2: 1200, y2: 1080, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-v6", "line", still(25.6, table{x1: 1440, y1: 0, x2: 1440, y2: 1080, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-v7", "line", still(25.6, table{x1: 1680, y1: 0, x2: 1680, y2: 1080, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-h1", "line", still(25.6, table{x1: 0, y1: 180, x2: 1920, y2: 180, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-h2", "line", still(25.6, table{x1: 0, y1: 360, x2: 1920, y2: 360, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-h3", "line", still(25.6, table{x1: 0, y1: 540, x2: 1920, y2: 540, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-h4", "line", still(25.6, table{x1: 0, y1: 720, x2: 1920, y2: 720, width: 1, color: "#8F8F86", alpha: 0.035}))
shape("grid-h5", "line", still(25.6, table{x1: 0, y1: 900, x2: 1920, y2: 900, width: 1, color: "#8F8F86", alpha: 0.035}))

// ─────────────────────────────────────────────────────────────────────────
// 01 — brand reveal
// ─────────────────────────────────────────────────────────────────────────
scene(3.8, 30)

shape("s1-bg", "rect", still(3.8, table{
  x: 0, y: 0, w: 1920, h: 1080,
  gradFrom: "#0D0D16", gradTo: "#060609", gradAngle: 120,
}))
shape("s1-halo-cyan", "circle", still(3.8, table{
  x: 960, y: 420, r: 380, color: cyan, alpha: 0.03,
}))
shape("s1-halo-gold", "circle", still(3.8, table{
  x: 1200, y: 700, r: 300, color: gold, alpha: 0.025,
}))

shape("s1-arc-a", "arc", table{
  "0.5": table{x: 960, y: 430, r: 245, start: 200, end: 200, width: 2, color: gold, alpha: 0.0},
  "1.7": table{x: 960, y: 430, r: 245, start: 200, end: 342, width: 2, color: gold, alpha: 0.55, ease: "sine"},
  "3.8": table{x: 960, y: 430, r: 255, start: 200, end: 342, width: 2, color: gold, alpha: 0.35},
})
shape("s1-arc-b", "arc", table{
  "0.7": table{x: 960, y: 430, r: 300, start: 20, end: 20, width: 1, color: cyan, alpha: 0.0},
  "1.9": table{x: 960, y: 430, r: 300, start: 20, end: 158, width: 1, color: cyan, alpha: 0.45, ease: "sine"},
  "3.8": table{x: 960, y: 430, r: 290, start: 20, end: 158, width: 1, color: cyan, alpha: 0.25},
})

svg("s1-mark", "examples/assets/kyfram-mark.svg", table{
  "0": table{x: 960, y: 470, w: 330, h: 330, rotate: -20, scale: 0.55, alpha: 0},
  "0.65": table{x: 960, y: 430, w: 330, h: 330, rotate: -4, scale: 1, alpha: 1, ease: "spring"},
  "1.4": table{x: 960, y: 430, w: 330, h: 330, rotate: 0, scale: 1.02, alpha: 1},
  "2.5": table{x: 960, y: 424, w: 330, h: 330, rotate: 2, scale: 1.04, alpha: 1},
  "3.8": table{x: 960, y: 430, w: 330, h: 330, rotate: 0, scale: 1, alpha: 1},
})

shape("s1-dot-gold", "circle", table{
  "0.9": table{x: 756, y: 522, r: 0, color: gold, alpha: 0},
  "1.5": table{x: 756, y: 510, r: 9, color: gold, alpha: 0.95, ease: "easeOut"},
  "2.6": table{x: 748, y: 500, r: 9, color: gold, alpha: 0.95},
  "3.8": table{x: 756, y: 510, r: 9, color: gold, alpha: 0.95},
})
shape("s1-dot-coral", "circle", table{
  "1.2": table{x: 1170, y: 342, r: 0, color: coral, alpha: 0},
  "1.8": table{x: 1170, y: 332, r: 7, color: coral, alpha: 0.9, ease: "easeOut"},
  "2.9": table{x: 1178, y: 320, r: 7, color: coral, alpha: 0.9},
  "3.8": table{x: 1170, y: 332, r: 7, color: coral, alpha: 0.9},
})

letters("s1-brand", "kyfram", table{
  "0.55": table{x: 960, y: 724, size: 154, color: white, font: display, alpha: 0, scale: 0.92},
  "1.15": table{x: 960, y: 700, size: 154, color: white, font: display, alpha: 1, scale: 1, ease: "spring"},
  "2.4": table{x: 960, y: 696, size: 154, color: white, font: display, alpha: 1, scale: 1},
  "3.8": table{x: 960, y: 700, size: 154, color: white, font: display, alpha: 1, scale: 1},
}, 0.055)

text("s1-tag", table{
  "0.95": table{content: "MOTION GRAPHICS FOR GO", x: 960, y: 792, size: 23, color: muted, font: body, alpha: 0},
  "1.45": table{content: "MOTION GRAPHICS FOR GO", x: 960, y: 788, size: 23, color: muted, font: body, alpha: 1, ease: "easeOut"},
  "3.8": table{content: "MOTION GRAPHICS FOR GO", x: 960, y: 788, size: 23, color: muted, font: body, alpha: 1},
})

shape("s1-rule", "rect", table{
  "1.1": table{x: 960, y: 842, w: 0, h: 3, gradFrom: cyan, gradTo: gold, gradAngle: 0, alpha: 0},
  "2.0": table{x: 760, y: 842, w: 400, h: 3, gradFrom: cyan, gradTo: gold, gradAngle: 0, alpha: 1, ease: "easeOut"},
  "3.8": table{x: 760, y: 842, w: 400, h: 3, gradFrom: cyan, gradTo: gold, gradAngle: 0, alpha: 1},
})

text("s1-version", table{
  "2.3": table{content: "v0.5.0  ·  OPEN SOURCE", x: 960, y: 982, size: 14, color: muted, font: body, alpha: 0},
  "2.8": table{content: "v0.5.0  ·  OPEN SOURCE", x: 960, y: 978, size: 14, color: muted, font: body, alpha: 0.8, ease: "easeOut"},
  "3.8": table{content: "v0.5.0  ·  OPEN SOURCE", x: 960, y: 978, size: 14, color: muted, font: body, alpha: 0.8},
})

// ─────────────────────────────────────────────────────────────────────────
