// touch-light-motivation.lgv — motivation lines, soft white light rising from below.
// 1080x1350 portrait. Canvas center = (540, 675).

let lines = ["You don't need motivation.", "You need discipline.", "Show up when it's hard.", "Especially when it's hard.", "That's how you win."]
let sizes = [48, 56, 52, 48, 62]
let fontPath = "examples/assets/fonts/Iceland-Regular.ttf"

for i, word in lines {
  if i == 0 {
    scene(4, 30)
  } else {
    scene(4, 30, "fade", 1.2)
  }

  let n = toStr(i)
  let sz = sizes[i]
  let isLast = i == 4
  let col = isLast ? "#ffd166" : "#f5f1e6"

  shape("bg${n}", "rect", table{
    "0": table{x: 0, y: 0, w: 1080, h: 1350, color: "#060609"}
  })

  // Outer glow: rises from below frame, soft white touch-light bloom.
  shape("glow${n}", "circle", table{
    "0":   table{x: 540, y: 1750, r: 430, color: "#ffffff", alpha: 0,    blend: "screen", ease: "cubicOut"},
    "2.2": table{x: 540, y: 1440, r: 430, color: "#ffffff", alpha: 0.18, blend: "screen"},
    "4":   table{x: 540, y: 1440, r: 430, color: "#ffffff", alpha: 0.18, blend: "screen"}
  })

  // Hot core: tighter, brighter — the "touch point" of the light.
  shape("core${n}", "circle", table{
    "0":   table{x: 540, y: 1750, r: 190, color: "#ffffff", alpha: 0,    blend: "screen", ease: "cubicOut"},
    "2.2": table{x: 540, y: 1470, r: 190, color: "#ffffff", alpha: 0.35, blend: "screen"},
    "4":   table{x: 540, y: 1470, r: 190, color: "#ffffff", alpha: 0.35, blend: "screen"}
  })

  // The line: fades in cubicOut, holds, fades out cubicInOut with a
  // slight upward drift on exit.
  text("word${n}", table{
    "0":   table{content: word, x: 540, y: 715, size: sz, color: col, font: fontPath, alpha: 0, ease: "cubicOut"},
    "0.9": table{content: word, x: 540, y: 675, size: sz, color: col, font: fontPath, alpha: 1},
    "2.8": table{content: word, x: 540, y: 675, size: sz, color: col, font: fontPath, alpha: 1, ease: "cubicInOut"},
    "3.8": table{content: word, x: 540, y: 665, size: sz, color: col, font: fontPath, alpha: 0}
  })
}
