scene(36, 30)

shape("bg", "rect", table{
    "0": table{x: -2000, y: -2000, w: 6000, h: 6000, color: "#05050a", gradFrom: "#05050a", gradTo: "#0a1e3f", gradAngle: 60, layer: -10},
})

shape("glow", "circle", table{
    "0":  table{x: 540, y: 960, r: 500, color: "#1f6feb", alpha: 0.15, blend: "screen", layer: -5, ease: "sine"},
    "9":  table{x: 540, y: 960, r: 580, color: "#1f6feb", alpha: 0.22, blend: "screen", layer: -5, ease: "sine"},
    "18": table{x: 540, y: 960, r: 500, color: "#1f6feb", alpha: 0.15, blend: "screen", layer: -5, ease: "sine"},
    "27": table{x: 540, y: 960, r: 580, color: "#1f6feb", alpha: 0.22, blend: "screen", layer: -5, ease: "sine"},
    "36": table{x: 540, y: 960, r: 500, color: "#1f6feb", alpha: 0.15, blend: "screen", layer: -5},
})

let line = fn(content, y, tStart, holdEnd, size, color) {
  let kf = table{}
  kf[toStr(tStart)]       = table{content: content, x: 540, y: y + 60, size: size, scale: 0.7,  rotate: -4, alpha: 0, color: color, ease: "cubicOut"}
  kf[toStr(tStart + 0.7)] = table{content: content, x: 540, y: y - 10, size: size, scale: 1.08, rotate: 1,  alpha: 1, color: color, ease: "cubicOut"}
  kf[toStr(tStart + 1.0)] = table{content: content, x: 540, y: y,      size: size, scale: 1.0,  rotate: 0,  alpha: 1, color: color}
  kf[toStr(holdEnd)]      = table{content: content, x: 540, y: y,      size: size, scale: 1.0,  rotate: 0,  alpha: 1, color: color}
  return kf
}

text("l1", line("You don't need motivation.", 700, 0, 36, 48, "#4da6ff"))
text("l2", line("You need discipline.", 830, 5, 36, 48, "#4da6ff"))
text("l3", line("Show up when it's hard.", 960, 10, 36, 48, "#4da6ff"))
text("l4", line("Especially when it's hard.", 1090, 15, 36, 48, "#4da6ff"))
text("l5", line("That's how you win.", 1220, 20, 36, 60, "#ffd166"))

scene(36, 30, "fade", 1)

