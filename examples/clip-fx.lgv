// clip-fx.lgv — clipping, shadows, blur, glow, and multiline text.
scene(3, 30)

shape("bg", "rect", table{
  "0": table{x: 0, y: 0, w: 640, h: 360, color: "#0b0b0f"},
})

// A group clip opening from a point to a circle. Everything inside the
// group (the gradient card) is cropped to the circle.
group("window", table{
  "0": table{x: 175, y: 180, clip: "circle", clipR: 0},
  "1.2": table{x: 175, y: 180, clip: "circle", clipR: 105},
})
shape("card", "rect", table{
  "0": table{x: -120, y: -120, w: 240, h: 240, gradFrom: "#5fd0c4", gradTo: "#f4b942", gradAngle: 45},
}, "window")

// Multiline text with a real shadow and glow.
text("title", table{
  "0": table{
    content: "MASK\nEFFECTS", x: 435, y: 150, size: 44, color: "#f6f1e7",
    wrap: 260, lineHeight: 1.1,
    shadowColor: "#000000", shadowBlur: 12, shadowY: 8,
    glow: "#5fd0c4", glowBlur: 14,
  },
})

// Blur is per entity and follows the circle's alpha, not a box.
shape("soft", "circle", table{
  "0": table{x: 450, y: 275, r: 30, color: "#ff6b4a", blur: 7},
})
